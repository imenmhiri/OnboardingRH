# Supabase — projet de developpement
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle de service : jamais exposee au navigateur, jamais commitee
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envoi des emails transactionnels
RESEND_API_KEY=
RESEND_FROM=

# n8n — webhooks des workflows W1 / W2 / W3
N8N_WEBHOOK_URL=
# Secret partage verifie a l'entree de chaque webhook (en-tete x-webhook-secret),
# compare en temps constant cote route API. Meme valeur cote n8n et cote app.
N8N_WEBHOOK_SECRET=
# Cote n8n uniquement (pas lu par l'app Next.js) : URL publique que les workflows
# appellent (W1 -> POST /api/hires/validated et /api/notifications/welcome-email,
# W2 -> POST /api/escalation/run, W3 -> POST /api/surveys/run,
# report de date (T-25) -> POST /api/journeys/reschedule, appele par le SIRH
# au moment ou une date d'arrivee change, pas par un workflow planifie).
ONBOARDING_APP_URL=

# Signe et limite dans le temps le lien du questionnaire de satisfaction envoye
# par W3 (T-23) — distinct de N8N_WEBHOOK_SECRET, un perimetre different (lien
# envoye a une personne exterieure vs webhook entrant n8n).
SURVEY_LINK_SECRET=

# Agenda — Google Calendar (T-25). Jeton de rafraichissement d'un compte de
# service dedie a l'agenda de la societe (pas le compte personnel d'un
# employe) et identifiant du calendrier cible. En l'absence de l'une de ces
# quatre variables, la creation d'evenements degrade proprement : chaque appel
# echoue en `provider_error`, trace dans audit_events, sans jamais empecher la
# creation du parcours ni casser le portail employe.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CALENDAR_ID=

# URL publique de l'application (liens signes dans les emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic — synthese IA anonymisee des verbatims de satisfaction (T-26).
# Appelee uniquement par POST /api/satisfaction/summarize (meme secret
# N8N_WEBHOOK_SECRET, declenchee par n8n sur son propre planning), jamais au
# moment ou le cockpit affiche la page. En l'absence de cette variable, la
# synthese degrade proprement : chaque tentative echoue en `provider_error`
# sans jamais empecher le reste du cockpit de s'afficher (le cache
# `ai_satisfaction_summaries` garde alors la derniere synthese connue, ou
# reste vide).
ANTHROPIC_API_KEY=

# Fournisseur de la synthese IA : `ollama` (gratuit, modele ouvert servi en
# local, aucun commentaire ne quitte l'infrastructure) ou `anthropic` (payant,
# utilise ANTHROPIC_API_KEY). Sans valeur : Anthropic si une cle est presente,
# sinon Ollama si OLLAMA_BASE_URL est defini.
AI_SUMMARY_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modele a telecharger au prealable : `ollama pull qwen2.5:3b`
OLLAMA_MODEL=qwen2.5:3b
