# Supabase — projet de developpement
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle de service : jamais exposee au navigateur, jamais commitee
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envoi des emails transactionnels
RESEND_API_KEY=
RESEND_FROM=

# n8n — webhooks des workflows W1 / W2 / W3
N8N_WEBHOOK_URL=
# Secret partage verifie a l'entree de chaque webhook
N8N_WEBHOOK_SECRET=

# Agenda
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# URL publique de l'application (liens signes dans les emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
